    <string name="app_name" translatable="false">TopLineDate</string>

    <!-- Accessibility service description -->
    <string name="a11y_desc">Shows the date and weekday next to the status bar clock. It does not read screen content; it only checks the position and size of system windows to tell whether an app is fullscreen. In automatic text color mode it only checks the brightness of the status bar when the app changes, and never saves or sends the screen.</string>

    <!-- Status bar date: SimpleDateFormat pattern used when the user has not set one.
         Empty = the locale's own short month/day/weekday pattern (e.g. "Thu, Nov 26"). -->
